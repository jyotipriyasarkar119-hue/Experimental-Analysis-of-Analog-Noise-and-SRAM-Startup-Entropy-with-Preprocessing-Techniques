/*
  Hybrid TRNG
  SRAM Startup + Floating Analog Noise
  2-Fold XOR Mixing + Von Neumann Debiasing
  Platform: Arduino Uno (ATmega328P)
*/

#define OUTPUT_BITS 256
#define SRAM_BYTES 512

uint8_t sram_buffer[SRAM_BYTES];


// ============================
// Collect SRAM Startup Data
// ============================
void collect_sram() {
  for (int i = 0; i < SRAM_BYTES; i++) {
    sram_buffer[i] = *((uint8_t*)(0x100 + i));
  }
}


// ============================
// Extract Bit from SRAM
// ============================
uint8_t sram_bit(int index) {
  uint8_t byte = sram_buffer[index / 8];
  return (byte >> (index % 8)) & 1;
}


// ============================
// Floating Analog Noise Bit
// ============================
uint8_t analog_bit() {
  uint16_t val = analogRead(A0);
  return val & 1;   // LSB extraction
}


// ============================
// 2-Fold XOR Mixing
// ============================
uint8_t mixed_bit(int index) {

  uint8_t result = sram_bit(index);

  // XOR two independent analog samples
  result ^= analog_bit();
  result ^= analog_bit();

  return result;
}


// ============================
// Von Neumann Debiasing
// ============================
int von_neumann_bit(int index) {

  uint8_t b1 = mixed_bit(index);
  uint8_t b2 = mixed_bit(index + 1);

  if (b1 == 0 && b2 == 1) return 0;
  if (b1 == 1 && b2 == 0) return 1;

  return -1;   // discard 00 or 11
}


// ============================
// Generate Final Random Bits
// ============================
void generate_random() {

  int produced = 0;
  int index = 0;

  Serial.println("Random Output:");

  while (produced < OUTPUT_BITS) {

    int bit = von_neumann_bit(index);
    index += 2;

    if (bit != -1) {
      Serial.print(bit);
      produced++;
    }

    if (index >= (SRAM_BYTES * 8 - 2)) {
      index = 0;   // wrap if SRAM exhausted
    }
  }

  Serial.println();
}


// ============================
// Setup
// ============================
void setup() {

  Serial.begin(115200);
  delay(2000);

  Serial.println("Hybrid TRNG: SRAM + Analog + 2X XOR + Von Neumann");

  collect_sram();
  generate_random();
}


// ============================
// Loop
// ============================
void loop() {
}
