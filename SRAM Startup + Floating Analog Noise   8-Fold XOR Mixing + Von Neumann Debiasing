/*
  Hybrid TRNG
  SRAM Startup + Floating Analog Noise
  8-Fold XOR Mixing + Von Neumann Debiasing
  Binary Output + Statistical Analysis
  Arduino Uno Safe
*/

#define OUTPUT_BITS 512
#define SRAM_BYTES 512

uint8_t sram_buffer[SRAM_BYTES];


// =========================
// Capture SRAM Startup
// =========================
void capture_sram() {
  volatile uint8_t *ptr = (volatile uint8_t *)0x0100;
  for (int i = 0; i < SRAM_BYTES; i++) {
    sram_buffer[i] = ptr[i];
  }
}


// =========================
// Extract SRAM Bit
// =========================
uint8_t get_sram_bit(int index) {
  uint8_t byte = sram_buffer[index / 8];
  return (byte >> (index % 8)) & 1;
}


// =========================
// Floating Analog Bit
// =========================
uint8_t analog_bit() {
  return analogRead(A0) & 1;
}


// =========================
// 8-Fold XOR Mixing
// =========================
uint8_t mixed_bit(int index) {

  uint8_t result = get_sram_bit(index);

  for (int i = 0; i < 8; i++) {
    result ^= analog_bit();
  }

  return result;
}


// =========================
// Shannon Entropy
// =========================
float shannon_entropy(float p) {
  if (p == 0 || p == 1) return 0;
  return -(p * log(p) / log(2)) - ((1 - p) * log(1 - p) / log(2));
}


// =========================
// Generate Random Output
// =========================
void generate_random() {

  int produced = 0;
  int index = 0;
  int total_bits = SRAM_BYTES * 8;

  int ones = 0;
  int zeros = 0;

  Serial.println("------------------------------------------------");
  Serial.println("Hybrid TRNG Output (8-Fold XOR + Von Neumann)");
  Serial.println("------------------------------------------------");

  while (produced < OUTPUT_BITS && index < total_bits - 1) {

    uint8_t b1 = mixed_bit(index);
    uint8_t b2 = mixed_bit(index + 1);

    if (b1 == 0 && b2 == 1) {
      Serial.print('0');
      zeros++;
      produced++;
    }
    else if (b1 == 1 && b2 == 0) {
      Serial.print('1');
      ones++;
      produced++;
    }

    index += 2;
  }

  Serial.println();
  Serial.println("------------------------------------------------");
  Serial.println("STATISTICS (8-Fold XOR + Von Neumann):");

  float p1 = (float)ones / OUTPUT_BITS;
  float p0 = (float)zeros / OUTPUT_BITS;
  float entropy = shannon_entropy(p1);

  Serial.print("Total Output Bits: ");
  Serial.println(OUTPUT_BITS);

  Serial.print("Ones: ");
  Serial.println(ones);

  Serial.print("Zeros: ");
  Serial.println(zeros);

  Serial.print("P(1): ");
  Serial.println(p1, 6);

  Serial.print("P(0): ");
  Serial.println(p0, 6);

  Serial.print("Shannon Entropy (per bit): ");
  Serial.println(entropy, 6);

  Serial.println("------------------------------------------------");
}


// =========================
// Setup
// =========================
void setup() {

  Serial.begin(9600);
  delay(2000);

  capture_sram();
  generate_random();
}


// =========================
// Loop
// =========================
void loop() {
}
