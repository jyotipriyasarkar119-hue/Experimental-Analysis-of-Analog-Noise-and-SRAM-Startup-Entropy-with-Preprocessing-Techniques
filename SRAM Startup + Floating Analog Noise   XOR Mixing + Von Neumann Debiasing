/*
  Hybrid TRNG
  SRAM Startup + Floating Analog Noise
  XOR Mixing + Von Neumann Debiasing
  Platform: Arduino Uno (ATmega328P)
*/

#define OUTPUT_BITS 256       // Final debiased output size
#define SRAM_BYTES 512        // SRAM sample size

uint8_t sram_buffer[SRAM_BYTES];


// ============================
// Read SRAM Startup Bits
// ============================
void collect_sram() {
  for (int i = 0; i < SRAM_BYTES; i++) {
    sram_buffer[i] = *((uint8_t*) (i + 0x100));  
  }
}


// ============================
// Get Floating Analog LSB
// ============================
uint8_t analog_noise_bit() {
  uint16_t val = analogRead(A0);
  return val & 1;  // LSB extraction
}


// ============================
// Get SRAM Bit
// ============================
uint8_t sram_bit(int index) {
  uint8_t byte = sram_buffer[index / 8];
  return (byte >> (index % 8)) & 1;
}


// ============================
// XOR Mixed Bit
// ============================
uint8_t mixed_bit(int index) {
  uint8_t b1 = sram_bit(index);
  uint8_t b2 = analog_noise_bit();
  return b1 ^ b2;
}


// ============================
// Von Neumann Debiasing
// ============================
int von_neumann_bit(int index) {
  uint8_t b1 = mixed_bit(index);
  uint8_t b2 = mixed_bit(index + 1);

  if (b1 == 0 && b2 == 1) return 0;
  if (b1 == 1 && b2 == 0) return 1;

  return -1;  // discard
}


// ============================
// Generate Random Bits
// ============================
void generate_random() {

  int produced = 0;
  int index = 0;

  Serial.println("Random Output:");

  while (produced < OUTPUT_BITS) {

    int result = von_neumann_bit(index);
    index += 2;

    if (result != -1) {
      Serial.print(result);
      produced++;
    }

    if (index >= SRAM_BYTES * 8 - 2) {
      index = 0;  // loop if exhausted
    }
  }

  Serial.println();
}


// ============================
// Setup
// ============================
void setup() {

  Serial.begin(115200);
  delay(2000);

  Serial.println("Hybrid TRNG: SRAM + Analog + XOR + Von Neumann");

  collect_sram();     // Capture SRAM startup
  generate_random();  // Generate final output
}


// ============================
// Loop
// ============================
void loop() {
  // Nothing
}
