/*
  Hybrid Entropy Generator
  SRAM Startup + Floating Analog Pin
  Arduino Uno (ATmega328P)
*/

#include <Arduino.h>
#include <math.h>

#define SRAM_START 0x0100
#define SRAM_BYTES 128      // 128 bytes = 1024 bits
#define ANALOG_PIN A0

void setup() {

  Serial.begin(9600);
  delay(2000);

  Serial.println("=== SRAM + FLOATING ANALOG ENTROPY ===");
  Serial.println("--------------------------------------");

  uint8_t *sram_ptr = (uint8_t*)SRAM_START;

  unsigned long totalBits = 0;
  unsigned long onesCount = 0;
  unsigned long zerosCount = 0;

  Serial.println("Final Bit Stream:");

  for (int i = 0; i < SRAM_BYTES; i++) {

    uint8_t sramByte = sram_ptr[i];

    for (int bit = 7; bit >= 0; bit--) {

      uint8_t sramBit = (sramByte >> bit) & 1;

      // Read analog noise
      int analogValue = analogRead(ANALOG_PIN);

      uint8_t analogBit = (analogValue & 1) ^
                          ((analogValue >> 1) & 1);

      // Combine both sources
      uint8_t finalBit = sramBit ^ analogBit;

      Serial.print(finalBit);

      totalBits++;

      if (finalBit == 1)
        onesCount++;
      else
        zerosCount++;

      delayMicroseconds(50);  // decorrelate
    }
  }

  Serial.println();
  Serial.println("--------------------------------------");

  float p1 = (float)onesCount / totalBits;
  float p0 = (float)zerosCount / totalBits;

  float entropy = 0;

  if (p1 > 0)
    entropy -= p1 * (log(p1) / log(2));

  if (p0 > 0)
    entropy -= p0 * (log(p0) / log(2));

  Serial.println("STATISTICS (Hybrid):");
  Serial.print("Total Bits: ");
  Serial.println(totalBits);

  Serial.print("Ones: ");
  Serial.println(onesCount);

  Serial.print("Zeros: ");
  Serial.println(zerosCount);

  Serial.print("P(1): ");
  Serial.println(p1, 6);

  Serial.print("P(0): ");
  Serial.println(p0, 6);

  Serial.print("Shannon Entropy: ");
  Serial.println(entropy, 6);

  Serial.println("--------------------------------------");
  Serial.println("Power OFF fully to regenerate SRAM.");
}

void loop() {
  // Runs only once at boot
}
